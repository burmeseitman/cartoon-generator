# Cartoon Generator Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# Output Configuration (NEW)
# ============================================

# Custom output directory for generated cartoons (default: ./output)
CARTOON_OUTPUT_DIR=./output

# Image filename format template (default: "{description}_{datetime}")
# Available placeholders:
#   {description}  - Sanitized article title/description (e.g., "claude-ai")
#   {datetime}     - Full timestamp like "20260725_233400"
#   {date}         - Date only like "20260725"
#   {time}         - Time only like "233400"
#
# Examples:
#   "{description}_{datetime}"   -> "claude-ai-20260725_233400.jpg"  (default)
#   "{description}_{date}.jpg"   -> "claude-ai-20260725.jpg"
#   "{date}_{description}.png"   -> "20260725_claude-ai.png"
#   "{description}.jpg"          -> "claude-ai.jpg"
IMAGE_FILENAME_FORMAT={description}_{datetime}

# ============================================
# Optional API Keys (fallbacks included)
# ============================================

# NewsAPI (optional - RSS feeds work without a key)
NEWS_API_KEY=your_newsapi_key_here

# Gemini API for image generation (PRIMARY — high quality, needs key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-image-preview  # current best model for image gen

# OpenAI (optional - fallback comedy analysis works without AI)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Pollinations.ai (automatic fallback — free, no key needed)
# If GEMINI_API_KEY is empty or Gemini fails, images are generated via Pollinations.ai
